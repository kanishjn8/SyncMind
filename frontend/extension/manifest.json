{
  "manifest_version": 3,
  "name": "Coursera Extractor",
  "version": "1.3",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://www.coursera.org/*",
    "https://*.coursera.org/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.coursera.org/*",
        "https://*.coursera.org/*"
      ],
      "js": ["coursera-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["landing-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
