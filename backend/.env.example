YOUTUBE_API_KEY=your_youtube_api_key
GITHUB_TOKEN=your_github_token
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
GIT_CLIENT_ID=your_github_oauth_client_id
GIT_CLIENT_SECRET=your_github_oauth_client_secret
# Must match the callback registered on your GitHub OAuth App exactly
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpbs
DB_USER=syncmind_user
DB_PASSWORD=syncmind_password_change_me
DATABASE_URL=mysql+mysqlconnector://syncmind_user:syncmind_password_change_me@127.0.0.1:3306/cpbs

SESSION_SECRET_KEY=change_me_to_a_long_random_string

# Used by /get_jobs to call Google Jobs via SerpApi
SERPAPI_KEY=your_serpapi_api_key

# Optional: RAG educational-keyword filter.
# Put the project knowledge base at backend/app/educational_kb.jsonl or point
# RAG_KB_PATH / EDUCATIONAL_KB_PATH at a JSON, JSONL, CSV, TXT, or Markdown file.
# Higher threshold = stricter filtering. Defaults are shown below.
# RAG_KB_PATH=app/educational_kb.jsonl
# RAG_SIMILARITY_THRESHOLD=0.45
# RAG_TOP_K=3
# RAG_CACHE_PATH=app/rag_embeddings.npz
# Deprecated compatibility fallback:
# KB_THRESHOLD=0.45
